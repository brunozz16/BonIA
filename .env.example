# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas estas claves a GitHub.

# ---------- Supabase ----------
# Panel de Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La "service_role" (NO la anon). Es secreta: solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Mercado Pago ----------
# Panel de Mercado Pago > Tus integraciones > tu app > Credenciales.
# Empezá con las de PRUEBA (TEST-...) y cambialas por las de producción
# recién cuando todo funcione.
MP_ACCESS_TOKEN=

# Tus integraciones > tu app > Webhooks > Configurar notificación.
# Al guardar la URL, Mercado Pago genera esta clave secreta.
MP_WEBHOOK_SECRET=

# ---------- Sitio ----------
# URL pública del sitio. En local dejalo así; en Vercel poné tu dominio.
NEXT_PUBLIC_URL_BASE=http://localhost:3000
